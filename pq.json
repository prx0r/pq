{
  "_comment": "pq configuration — all scripts read from this file",

  "vault": {
    "path": "~/.qpbot/vault.json",
    "key_path": "~/.qpbot/vault.key"
  },

  "llm": {
    "model": "muse-spark-1.3-contributor",
    "base_url": "https://opencode.ai/zen/go/v1",
    "api_key_env": "PQ_API_KEY",
    "max_output_tokens": 1024
  },

  "arena": {
    "qp_bot": "/home/ubuntu/qpbot",
    "pack": "demo"
  },

  "spend": {
    "cap_tokens": 0,
    "cap_minor": 0
  },

  "dashboard": {
    "port": 8791,
    "host": "127.0.0.1"
  },

  "scanners": {
    "gh_token_env": "GH_TOKEN"
  }
}
